    "\n",
    "class Partida:\n",
    "    \n",
    "\n",
    "    def __init__(self, id_partida: int, nome_artilheiro: str, total_gols: int):\n",
    "        self.id_partida = id_partida\n",
    "        self.nome_artilheiro = nome_artilheiro\n",
    "        self.total_gols = total_gols\n",
    "\n",
    "    def __str__(self):\n",
    "        return (\n",
    "            f\"Partida(id={self.id_partida}, artilheiro={self.nome_artilheiro}, \"\n",
    "            f\"total_gols={self.total_gols})\"\n",
    "        )\n",
    "\n",
    "    def __repr__(self):\n",
    "        return str(self)\n",
    "\n",
    "\n",
    "    def criar_partida(nome_artilheiro: str, total_gols: int) -> Partida | None:\n",
    "        \n",
    "        try:\n",
    "            cursor.execute(\n",
    "                \"\"\"INSERT INTO partida (nome_artilheiro, total_gols)\n",
    "                  VALUES (%s, %s) RETURNING id_partida\"\"\",\n",
    "                (nome_artilheiro, total_gols)\n",
    "            )\n",
    "            id_partida = cursor.fetchone()[0]\n",
    "            conexao.commit()\n",
    "            return Partida(id_partida, nome_artilheiro, total_gols)\n",
    "        except pg.DatabaseError as e:\n",
    "            print(\"Erro ao criar partida:\", e)\n",
    "            conexao.rollback()\n",
    "            return None\n",
    "\n",
    "\n",
    "    def listar_partidas() -> list[Partida]:\n",
    "        \n",
    "        partidas = []\n",
    "        try:\n",
    "            cursor.execute(\n",
    "                \"\"\"SELECT id_partida, nome_artilheiro, total_gols\n",
    "                FROM partida ORDER BY id_partida\"\"\"\n",
    "             )\n",
    "            for linha in cursor.fetchall():\n",
    "                partidas.append(Partida(linha[0], linha[1], linha[2]))\n",
    "        except pg.DatabaseError as e:\n",
    "            print(\"Erro ao listar partidas:\", e)\n",
    "            conexao.rollback()\n",
    "        return partidas\n",
    "\n",
    "\n",
    "    def buscar_partida(id_partida: int) -> Partida | None:\n",
    "    \n",
    "        try:\n",
    "            cursor.execute(\n",
    "                \"\"\"SELECT id_partida, nome_artilheiro, total_gols\n",
    "                FROM partida WHERE id_partida = %s\"\"\",\n",
    "                (id_partida,)\n",
    "            )\n",
    "            linha = cursor.fetchone()\n",
    "            if linha:\n",
    "                return Partida(linha[0], linha[1], linha[2])\n",
    "            return None\n",
    "        except pg.DatabaseError as e:\n",
    "            print(\"Erro ao buscar partida:\", e)\n",
    "            conexao.rollback()\n",
    "            return None\n",
    "\n",
    "\n",
    "    def atualizar_partida(partida: Partida) -> bool:\n",
    "    \n",
    "        try:\n",
    "            cursor.execute(\n",
    "                \"\"\"UPDATE partida\n",
    "                SET nome_artilheiro = %s, total_gols = %s\n",
    "                WHERE id_partida = %s\"\"\",\n",
    "                (partida.nome_artilheiro, partida.total_gols, partida.id_partida)\n",
    "            )\n",
    "            alteradas = cursor.rowcount\n",
    "            conexao.commit()\n",
    "            return alteradas > 0\n",
    "        except pg.DatabaseError as e:\n",
    "            print(\"Erro ao atualizar partida:\", e)\n",
    "            conexao.rollback()\n",
    "            return False\n",
    "\n",
    "\n",
    "    def deletar_partida(id_partida: int) -> bool:\n",
    "        \n",
    "        try:\n",
    "            cursor.execute(\"DELETE FROM partida WHERE id_partida = %s\", (id_partida,))\n",
    "            apagadas = cursor.rowcount\n",
    "            conexao.commit()\n",
    "            return apagadas > 0\n",
    "        except pg.DatabaseError as e:\n",
    "            print(\"Erro ao deletar partida (verifique se ha agendamentos ligados):\", e)\n",
    "            conexao.rollback()\n",
    "            return False\n",
