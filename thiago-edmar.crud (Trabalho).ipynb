    "\n",
    "        id_quadra = cursor.fetchone()[0]\n",
    "        conexao.commit()\n",
    "\n",
    "        return Quadra(id_quadra, preco, coberta)\n",
    "\n",
    "    except pg.DatabaseError as e:\n",
