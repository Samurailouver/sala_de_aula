    "\n",
    "SELECT 'plataforma' AS tabela, COUNT(*) AS linhas FROM plataforma\n",
    "UNION ALL SELECT 'cliente',    COUNT(*) FROM cliente\n",
    "UNION ALL SELECT 'jogo',       COUNT(*) FROM jogo\n",
    "UNION ALL SELECT 'emprestimo', COUNT(*) FROM emprestimo;"
