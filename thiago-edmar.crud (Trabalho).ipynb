    "            \"\"\"\n",
    "            INSERT INTO quadra (preco, coberta)\n",
    "            VALUES (%s, %s)\n",
    "            RETURNING id_quadra\n",
    "            \"\"\",\n",
    "            (preco, coberta)\n",
