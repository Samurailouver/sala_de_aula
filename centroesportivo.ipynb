    "class Partida():\n",
    "    id_partida: int\n",
    "    nome_artilheiro: str\n",
    "    total_gols: int\n",
    "\n",
    "def __init__(self, nome_artilheiro:str, total_gols:int):\n",
    "        self.nome_artilheiro=nome_artilheiro\n",
    "        self.total_gols=total_gols\n",
    "\n",
    "def __str__(self):\n",
    "        return f\"Partida( nome_artilheiro[{self.nome_artilheiro}, total_gols={self.total_gols}])\"\n",
    "\n",
    "def __repr__(self):\n",
    "        return f\"Partida {self.nome_artilheiro}\"\n",
    "    \n",
    "def criar_Partida(nome_artilheiro: str, total_gols: int | None) -> Partida | None:\n",
    "        try:     \n",
    "         cursor.execute(\n",
    "                \"INSERT INTO PARTIDA (id_partida,nome_artilheiro, tota_gols)\"\n",
    "                \"VALUES (%s, %s) RETURNING id_partida\",\n",
    "                (nome_artilheiro, total_gols)\n",
    "                )\n",
