    "    coberta: bool  \n",
    "    \n",
    "def __init__(self, id_quadra: int, preco: float, coberta: bool):\n",
    "            self.id_quadra= id_quadra\n",
    "            self.preco= preco\n",
    "            self.coberta = coberta\n",
    "\n",
    "def __str__(self):\n",
