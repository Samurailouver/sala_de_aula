    "\n",
    "def __repr__(self):\n",
    "            return f\"Quadra({self.id_quadra} - {self.preco})\"\n",
    "    \n",
    "    \n",
    "def criar_quadra(preco: float, coberta:bool | None) -> Quadra | None:\n",
    "        try:\n",
    "            cursor.execute(\n",
    "                \"INSERT INTO cliente (preco, coberta) \"\n",
    "                \"VALUES (%s, %s) RETURNING id_quadra\",\n",
